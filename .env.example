POSTGRES_USER=jobtracker
POSTGRES_PASSWORD=pon_algo_tuyo_aqui
POSTGRES_DB=jobtracker
POSTGRES_PORT=5432
# Para `go run` en tu PC (host = localhost).
# En Docker Compose el backend usa host `db` automáticamente.
DATABASE_URL=postgres://jobtracker:pon_algo_tuyo_aqui@localhost:5432/jobtracker?sslmode=disable
PORT=8088
APP_API_KEY=replace_with_long_random_secret
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3847
# Opcional — OpenAI-compatible (OpenAI, Groq, OpenRouter, Ollama…).
# Sin LLM_API_KEY el chat usa el brain "rules" (keywords).
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini